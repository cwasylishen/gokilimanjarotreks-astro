{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gokilimanjarotreks-astro",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
