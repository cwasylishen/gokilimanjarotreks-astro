      <div class="cta-actions">
        <a href="/contact" class="btn-primary" style="font-size:1.05rem;padding:18px 40px">Ask About Kosovo Camp &#x2192;</a>
        <a href="https://wa.me/255677917500" class="btn-wa-lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp Nelson</a>
      </div>
    </div>
  </div>
</section>
</main>
</BaseLayout>
