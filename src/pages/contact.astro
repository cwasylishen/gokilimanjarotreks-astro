---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, OFFICES } from '../data/site';
// The TravelAgency / LocalBusiness graph (address, phone, emergency line, Kenya
// office) is emitted sitewide from ORG_LD in BaseLayout. No duplicate here.
const schemas = [{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://gokilimanjarotreks.com/"},{"@type":"ListItem","position":2,"name":"Contact","item":"https://gokilimanjarotreks.com/contact"}],"dateModified":"2026-05-26"}];
---

<BaseLayout
  title="Book Your Kilimanjaro Trek: Contact Nelson"
  description="Ready to climb Kilimanjaro? Contact Nelson Mushi at Go Kilimanjaro Treks for a free consultation and custom quote. WhatsApp, email, or enquiry form. Based in Moshi, Tanzania."
  ogImage="https://gokilimanjarotreks.com/images/og-contact.jpg"
  ogImageAlt="Contact Go Kilimanjaro Treks for Kilimanjaro climbs and Tanzania safaris"
  schemas={schemas}
>
  <main>
<section class="page-hero" style="background:var(--ink)">
  <picture><source type="image/webp" srcset="/images/page-hero-contact.webp"><img src="/images/page-hero-contact.jpg" alt="" aria-hidden="true" loading="eager" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:0;opacity:0.7"></picture>
<div aria-hidden="true" style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(2,6,14,0.88) 0%,rgba(2,6,14,0.82) 40%,rgba(2,6,14,0.55) 65%,rgba(2,6,14,0.15) 100%);z-index:1"></div>
  <div class="container">
    <span class="page-hero-eyebrow">Free Consultation &bull; 24hr Response</span>
    <h1>Let's Plan Your<br><em>Kilimanjaro</em> Climb.</h1>
    <p>Tell Nelson your dates, group size, and dream. He'll respond personally within 24 hours with honest route advice and a transparent all-inclusive quote.</p>
  </div>
</section>

<!-- CONTACT FORM + SIDEBAR -->
<section class="section-white">
  <div class="container">
    <div class="contact-grid">
      <div class="reveal">
        <span class="section-eyebrow">Enquiry Form</span>
        <h2 class="section-title">Get Your Free Quote</h2>
        <p style="font-size:.95rem;color:var(--muted);line-height:1.7;margin-bottom:32px;margin-top:8px">Fill in as much detail as you have. Nelson will use this to put together a personalised route recommendation and price. No commitment required.</p>
        <form id="enquiry-form" class="enquiry-form" action="https://formsubmit.co/ajax/info@gokilimanjarotreks.com" method="POST" aria-label="Trip enquiry form">
          <input type="hidden" name="_subject" value="New enquiry from gokilimanjarotreks.com">
          <input type="hidden" name="_template" value="table">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_autoresponse" value="Thank you for your enquiry with Go Kilimanjaro Treks. Nelson Mushi will reply personally within 24 hours with route advice and a transparent quote. If you need an immediate answer, WhatsApp him at +255 677 917 500.">
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" placeholder="Company">
          <div class="form-row">
            <div class="form-group">
              <label for="f-name">Your Name *</label>
              <input type="text" id="f-name" name="name" required placeholder="First &amp; last name" autocomplete="name">
            </div>
            <div class="form-group">
              <label for="f-email">Email Address *</label>
              <input type="email" id="f-email" name="email" required placeholder="you@email.com" autocomplete="email">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="f-phone">WhatsApp / Phone</label>
              <input type="tel" id="f-phone" name="phone" placeholder="+1 555 000 0000" autocomplete="tel">
            </div>
            <div class="form-group">
              <label for="f-country">Country</label>
              <input type="text" id="f-country" name="country" placeholder="Your country" autocomplete="country-name">
            </div>
          </div>
          <div class="form-group">
            <label for="f-trip">What are you interested in? *</label>
            <select id="f-trip" name="trip_type" required>
              <option value="" disabled selected>Select trip type</option>
              <option value="kilimanjaro-lemosho">Kilimanjaro: Lemosho Route (7 Days)</option>
              <option value="kilimanjaro-northern">Kilimanjaro: Northern Circuit (9-10 Days)</option>
              <option value="kilimanjaro-marangu">Kilimanjaro: Marangu Route (5-6 Days)</option>
              <option value="kilimanjaro-rongai">Kilimanjaro: Rongai Route (7 Days)</option>
              <option value="kilimanjaro-umbwe">Kilimanjaro: Umbwe Route (6 Days)</option>
              <option value="kilimanjaro-machame-8">Kilimanjaro: Machame Route (8 Days, recommended)</option>
              <option value="kilimanjaro-machame-7">Kilimanjaro: Machame Route (7 Days)</option>
              <option value="safari">Tanzania Wildlife Safari</option>
              <option value="wedding">Kilimanjaro Wedding / Celebration</option>
              <option value="combo">Kilimanjaro + Safari Combo</option>
              <option value="zanzibar">Zanzibar Beach Extension</option>
              <option value="unsure">Not Sure, Please Advise</option>
            </select>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="f-dates">Preferred Dates</label>
              <input type="text" id="f-dates" name="dates" placeholder="e.g. July 2026 or flexible">
            </div>
            <div class="form-group">
              <label for="f-group">Group Size</label>
              <select id="f-group" name="group_size">
                <option value="">Select size</option>
                <option value="solo">Solo (1 person)</option>
                <option value="couple">Couple (2 people)</option>
                <option value="small">Small group (3-5)</option>
                <option value="medium">Medium group (6-10)</option>
                <option value="large">Large group (10+)</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="f-fitness">Your Fitness Level</label>
            <select id="f-fitness" name="fitness">
              <option value="">Select level</option>
              <option value="beginner">Beginner: I'm new to hiking</option>
              <option value="moderate">Moderate: I hike regularly</option>
              <option value="fit">Fit: I train regularly, multi-day hiking experience</option>
              <option value="experienced">Experienced: Prior high-altitude trekking</option>
            </select>
          </div>
          <div class="form-group">
            <label for="f-message">Tell Nelson about your trip</label>
            <textarea id="f-message" name="message" placeholder="Any questions, special requirements, or details about your group. The more you share, the better Nelson can advise you."></textarea>
          </div>
          <p id="form-status" role="status" aria-live="polite" hidden style="margin-bottom:16px;padding:12px 16px;border-radius:10px;font-weight:500"></p>
          <button type="submit" class="btn-submit">Send My Enquiry &rarr;</button>
          <p class="form-note">Nelson responds personally within 24 hours. No bots, no automated replies.</p>
        </form>
      </div>
      <div class="contact-sidebar reveal">
        <a href="https://wa.me/255677917500" class="contact-method" target="_blank" rel="noopener" style="text-decoration:none">
          <div class="cm-icon cm-wa">&#x1F4AC;</div>
          <div>
            <div class="cm-title">WhatsApp Nelson</div>
            <div class="cm-value">+255 677 917 500</div>
            <div class="cm-note">Fastest response &bull; Usually within minutes</div>
          </div>
        </a>
        <a href="mailto:info@gokilimanjarotreks.com" class="contact-method" style="text-decoration:none">
          <div class="cm-icon cm-email">&#x2709;&#xFE0F;</div>
          <div>
            <div class="cm-title">Email Us</div>
            <div class="cm-value">info@gokilimanjarotreks.com</div>
            <div class="cm-note">Detailed enquiries welcome &bull; 24hr response</div>
          </div>
        </a>
        <a href="tel:+255677917500" class="contact-method" style="text-decoration:none">
          <div class="cm-icon cm-phone">&#x1F4DE;</div>
          <div>
            <div class="cm-title">Call Nelson</div>
            <div class="cm-value">+255 677 917 500</div>
            <div class="cm-note">East Africa Time (EAT) &bull; UTC+3</div>
          </div>
        </a>
        <div class="promise-box">
          <h3>What Happens Next</h3>
          <div class="promise-list">
            <div class="promise-item">Nelson reads your enquiry personally</div>
            <div class="promise-item">You receive a custom route recommendation within 24 hours</div>
            <div class="promise-item">A detailed, transparent all-inclusive quote follows</div>
            <div class="promise-item">No pressure, no hidden fees, no commitment required</div>
            <div class="promise-item">Secure your dates with a small deposit when ready</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- OFFICES -->
<section class="section-tinted" id="offices">
  <div class="container">
    <div class="reveal" style="max-width:640px">
      <span class="section-eyebrow">Where to Find Us</span>
      <h2 class="section-title">Two Offices, One Team</h2>
      <p style="font-size:.97rem;color:var(--muted);line-height:1.7;margin-top:12px">Nelson runs the head office in Moshi, at the foot of the mountain. Andrew looks after travellers joining us from Nairobi and the Kenyan side of the border.</p>
    </div>
    <div class="offices-grid">
      {OFFICES.map((office) => (
        <div class:list={['office-card', 'reveal', office.id === 'kenya' && 'office-card--kenya']} id={`${office.id}-office`}>
          <span class="office-label">{office.label}</span>
          <h3 class="office-name">{office.name}</h3>
          <p class="office-person"><strong>{office.person}</strong>, {office.role}</p>
          <div class="office-lines">
            <a class="office-line" href={`https://wa.me/${office.whatsappIntl}`} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 2.135.558 4.14 1.535 5.878L.054 23.617c-.1.334.218.649.551.546l5.865-1.857A11.946 11.946 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.6a9.597 9.597 0 01-4.916-1.354l-.352-.21-3.658 1.158 1.175-3.557-.23-.365A9.597 9.597 0 012.4 12C2.4 6.698 6.698 2.4 12 2.4S21.6 6.698 21.6 12 17.302 21.6 12 21.6z"/><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
              <span class="office-line-body">
                <span class="office-line-label">WhatsApp</span>
                <span class="office-line-value">{office.whatsapp}</span>
              </span>
            </a>
            {office.voice && (
              <a class="office-line" href={`tel:${office.whatsapp.replace(/\s/g, '')}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span class="office-line-body">
                  <span class="office-line-label">Call the office</span>
                  <span class="office-line-value">{office.whatsapp}</span>
                </span>
              </a>
            )}
            <a class="office-line" href={`mailto:${office.email}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span class="office-line-body">
                <span class="office-line-label">Email</span>
                <span class="office-line-value">{office.email}</span>
              </span>
            </a>
            <address class="office-address">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{office.addressLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</span>
            </address>
          </div>
          {office.emergencyIntl && (
            <a class="office-emergency" href={`tel:${office.emergencyIntl}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
              <span>
                <span class="office-emergency-label">Emergency line, 24 hours</span>
                <span class="office-emergency-value">{office.emergency}</span>
                <span class="office-emergency-note">For climbers already on the mountain and their families at home. Please use WhatsApp above for bookings and quotes.</span>
              </span>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="section-dark">
  <div class="container">
    <div style="text-align:center;margin-bottom:48px" class="reveal">
      <span class="section-eyebrow light">The Process</span>
      <h2 class="section-title light">Simple Steps to the Summit</h2>
    </div>
    <div class="steps-mini">
      <div class="step-mini reveal"><div class="step-mini-num">1</div><h3 class="step-mini-title">Reach Out</h3><p class="step-mini-desc">WhatsApp, email, or this form. Tell Nelson about your dates and what you're looking for.</p></div>
      <div class="step-mini reveal"><div class="step-mini-num">2</div><h3 class="step-mini-title">Get Your Plan</h3><p class="step-mini-desc">Nelson responds with a personal route recommendation and a full transparent quote within 24 hours.</p></div>
      <div class="step-mini reveal"><div class="step-mini-num">3</div><h3 class="step-mini-title">Secure Your Dates</h3><p class="step-mini-desc">Confirm with a deposit. We handle all permits, logistics, and porter arrangements from here.</p></div>
      <div class="step-mini reveal"><div class="step-mini-num">4</div><h3 class="step-mini-title">Reach Uhuru Peak</h3><p class="step-mini-desc">Arrive in Moshi, meet Nelson, and begin the adventure of a lifetime. We handle everything else.</p></div>
    </div>
    <div style="text-align:center;margin-top:48px" class="reveal">
      <p style="color:rgba(255,255,255,.7);font-size:.97rem;max-width:560px;margin:0 auto 24px">Kilimanjaro spots fill up quickly in peak season (July-September). The sooner you reach out, the more date options we'll have for you.</p>
      <a href="https://wa.me/255677917500" style="display:inline-flex;align-items:center;gap:12px;padding:16px 36px;background:#25d366;color:var(--white);border-radius:12px;font-weight:700;font-size:1rem;transition:background .2s" target="_blank" rel="noopener">&#x1F4AC; WhatsApp Nelson Now</a>
    </div>
  </div>
</section>

</main>

<script define:vars={{ sheetEndpoint: SITE.sheetEndpoint }}>
  /* Enquiry form: submit via fetch to FormSubmit (email) and, if configured,
     log the lead to a Google Sheet. Shows an inline status message. */
  (function () {
    var form = document.getElementById('enquiry-form');
    var status = document.getElementById('form-status');
    if (!form || !status) return;
    /* Pre-fill from the price calculator (/prices?trip=...&group=N) */
    try {
      var q = new URLSearchParams(location.search);
      var trip = q.get('trip'); var group = q.get('group');
      if (trip && form.elements.message && !form.elements.message.value) {
        form.elements.message.value = 'I used the price calculator and I\'m interested in the ' + trip
          + (group ? ' for ' + group + (group === '1' ? ' person' : ' people') : '') + '. Please send me a quote.';
      }
      if (group && form.elements.group_size) {
        var map = { 1: 'solo', 2: 'couple', 3: 'small', 4: 'small', 5: 'small', 6: 'medium', 7: 'medium', 8: 'medium' };
        if (map[group]) form.elements.group_size.value = map[group];
      }
    } catch (_) {}
    function show(msg, ok) {
      status.hidden = false;
      status.style.background = ok ? '#dcfce7' : '#fee2e2';
      status.style.color = ok ? '#166534' : '#991b1b';
      status.textContent = msg;
    }
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (form.elements._honey && form.elements._honey.value) return; // honeypot
      if (!String(form.elements.email.value).includes('@')) {
        show('Please enter a valid email address.', false); return;
      }
      var btn = form.querySelector('.btn-submit');
      var label = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }
      var data = new FormData(form);
      try {
        var res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
        if (!res.ok) throw new Error('failed');
        if (sheetEndpoint) {
          try { fetch(sheetEndpoint, { method: 'POST', mode: 'no-cors', body: data }); } catch (_) {}
        }
        form.reset();
        form.style.display = 'none';
        show('Thank you. Your enquiry is on its way to Nelson. He replies personally within 24 hours.', true);
        status.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } catch (err) {
        if (btn) { btn.disabled = false; btn.textContent = label; }
        show('Something went wrong. Please email info@gokilimanjarotreks.com or WhatsApp +255 677 917 500.', false);
      }
    });
  })();
</script>

</BaseLayout>