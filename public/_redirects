# 301 redirects for legacy URLs from the old WordPress site that used to run
# on this domain. Google still has these indexed; sending them to the closest
# live page recovers the traffic and clears the "Not found (404)" report.
# Cloudflare static-assets _redirects: path match, first rule wins, query
# strings are forwarded to the destination. A wildcard (*) must be trailing.

# ── Old .php pages ──────────────────────────────────────────────────────────
/about.php                     /about          301
/contact.php                   /contact        301
/index.php                     /               301
/home.php                      /               301
/safari.php                    /safari         301
/safari-2.php                  /safaris        301
/safari-details.php            /safaris        301
/destination-details.php       /destinations   301
/daytrip-details.php           /daytrips       301
/kilimanjaroroutes-details.php /kilimanjaro    301
/kilimanjaroguid-details.php   /kilimanjaro    301
/Kilimanjaroguid-details.php   /kilimanjaro    301
/tanzania-mountains.php        /destinations   301
/tanzania-mountains-2.php      /destinations   301

# ── Old WordPress permalink structures ──────────────────────────────────────
/destination/*                 /destinations   301
/tour/*                        /safaris        301
/tour-type/*                   /kilimanjaro    301
/Tour%20Type/*                 /kilimanjaro    301
/accommodation-location/*      /               301
/go-kilimanjaro-treks-trusted-tanzania-tour-operator/  /about  301

